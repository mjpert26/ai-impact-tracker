    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 8, system: \"Classify the last message of a sales conversation into EXACTLY one word: Positive, Neutral, Negative, or Opt-out. IMPORTANT: if the message is the salesperson's/bot's own outbound pitch or follow-up (not something the customer wrote), output Neutral. Positive = interested, wants to proceed, asks to move forward. Negative = not interested, frustrated, declines. Opt-out = asks to stop/unsubscribe/remove or legal threat. Neutral = anything else. Output ONLY the one word.\", messages: [ { role: 'user', content: String($json.last_message).slice(0, 1500) } ] }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        440,
        0
      ],
      "id": "aaaa1111-0000-4000-8000-000000000003",
      "name": "Classify (Claude Haiku)",
      "credentials": {
        "httpCustomAuth": {
          "id": "tkrE610QOjpv1yIn",
          "name": "Anthropic (AI Impact)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const meta=$('Fetch unclassified batch').all();\nconst resps=$input.all();\nfunction norm(t){t=String(t||'').toLowerCase();if(t.includes('opt'))return 'Opt-out';if(t.includes('posit'))return 'Positive';if(t.includes('negat'))return 'Negative';return 'Neutral';}\nconst rows=[];\nfor(let i=0;i<meta.length;i++){\n  let txt='';\n  try{txt=resps[i].json.content[0].text;}catch(e){continue;}\n  if(!txt)continue;\n  rows.push({location_id:meta[i].json.location_id,contact_id:meta[i].json.contact_id,sentiment:norm(txt)});\n}\nreturn [{json:{p_rows:rows,classified:rows.length}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "id": "aaaa1111-0000-4000-8000-000000000004",
      "name": "Collect sentiments"
    },
